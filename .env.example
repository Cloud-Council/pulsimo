# ==============================================================================
# PULSIMO - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy to .env, change the secrets, then start:
#   docker compose up -d                                   (built from source)
#
# After changing a value, recreate the services that read it, e.g.
#   docker compose up -d api-gateway metrics-collector
# The full reference (what each value does, which service reads it, when to change
# it) is docs/user-guide/24-configuration.md.
# ==============================================================================

# ------------------------------------------------------------------------------
# RELEASE (docker-compose.yml only)
# ------------------------------------------------------------------------------
# Each pulsimo/* image has its own default tag in docker-compose.yml. Override one:
# MIGRATIONS_VERSION=  API_GATEWAY_VERSION=  CHECKER_VERSION=  NOTIFICATION_VERSION=
# DEPENDENCY_TRACKER_VERSION=  MAINTENANCE_VERSION=  METRICS_COLLECTOR_VERSION=  FRONTEND_VERSION=
# Or put every image on one tag published with ./build-and-push.sh (leave unset otherwise):
# PULSIMO_VERSION=v1-rc2beta
# Version shown in the web app
APP_VERSION=v1beta1

# ------------------------------------------------------------------------------
# ADDRESSES AND PORTS
# ------------------------------------------------------------------------------
# Server IP or name people use to reach Pulsimo. The web app talks to
# http://HOST_IP:EXPOSE_API_PORT unless NEXT_PUBLIC_API_URL is set.
HOST_IP=localhost

# Behind a domain or HTTPS (reverse proxy)? Set both; they take priority over HOST_IP.
# NEXT_PUBLIC_API_URL=https://pulsimo.example.com
# NEXT_PUBLIC_WS_URL=wss://pulsimo.example.com

# Ports published on the host (change on conflicts)
EXPOSE_FRONTEND_PORT=3000
EXPOSE_API_PORT=8080
EXPOSE_POSTGRES_PORT=5432
EXPOSE_REDIS_PORT=6379

# Address your servers use to send logs, written into generated Fluent Bit configs
# (e.g. https://pulsimo.example.com). Empty = the address the browser used.
LOG_INGEST_PUBLIC_URL=

# ------------------------------------------------------------------------------
# SECRETS - change all of these before going live
# ------------------------------------------------------------------------------
POSTGRES_PASSWORD=ChangeThisPassword123!
# Signs sign-in tokens. Changing it signs everyone out. openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_RANDOM_SECRET_IN_PRODUCTION_USE_OPENSSL_RAND
# Encrypts metric-source credentials. Same value for api-gateway and metrics-collector.
# Changing it means re-entering the credentials of sources that use auth.
METRICS_SECRET_KEY=CHANGE_THIS_TO_RANDOM_SECRET

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL) AND REDIS
# ------------------------------------------------------------------------------
POSTGRES_DB=monitoring_system
POSTGRES_USER=monitoring
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# Port PostgreSQL listens on inside the Docker network (maintenance-scheduler)
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379
# true for ONE start re-applies every migration (e.g. after restoring an old dump)
MIGRATIONS_FORCE_RERUN=false

# ------------------------------------------------------------------------------
# EMAIL ALERTS (notification service)
# ------------------------------------------------------------------------------
# Port 587 = STARTTLS, 465 = TLS. Gmail needs an App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Pulsimo Monitoring
# Low-urgency findings (anomalies, capacity, log spikes) are grouped into one
# message per organization this often
DIGEST_INTERVAL_MINUTES=60
# Address people open Pulsimo at; alarm messages link to it ("Open in Pulsimo").
# Empty = http://HOST_IP:EXPOSE_FRONTEND_PORT
PULSIMO_PUBLIC_URL=

# ------------------------------------------------------------------------------
# ALARM RULES (metrics-collector)
# ------------------------------------------------------------------------------
# How often alarm rules are evaluated (10-300)
ALARM_EVAL_SECONDS=30

# ------------------------------------------------------------------------------
# ENDPOINT CHECKS AND INCIDENTS (checker)
# ------------------------------------------------------------------------------
# Each endpoint's interval, timeout, retries and alert policy are set on the endpoint.
# Checks running at the same time across all endpoints (10-5000)
MAX_CONCURRENT_CHECKS=300
# A new failure within this many minutes of recovery reopens the last incident
# instead of opening a new one (0 = always a new incident). Also used for log incidents.
INCIDENT_REOPEN_MINUTES=10

# ------------------------------------------------------------------------------
# LOGS (VictoriaLogs, Fluent Bit, log analysis)
# ------------------------------------------------------------------------------
# How long log lines are kept (read by VictoriaLogs at start)
LOGS_RETENTION=7d
# Default lines per second accepted per log source (a source can set its own)
LOG_INGEST_MAX_LINES_PER_SEC=2000
# Longer lines are cut (256 - 1048576)
LOG_INGEST_MAX_LINE_BYTES=16384
# Fluent Bit image in generated run commands
LOG_AGENT_IMAGE=fluent/fluent-bit:3.1
# How often new warning/error lines are grouped into patterns, and the most read per pass
LOG_PATTERN_INTERVAL_SECONDS=60
LOG_PATTERN_MAX_LINES=5000

# ------------------------------------------------------------------------------
# INCIDENTS FROM LOGS (defaults; each scope can override them in the app)
# ------------------------------------------------------------------------------
LOG_INCIDENTS_ENABLED=true
# Errors of one pattern in the window that open a warning / make it critical
LOG_INCIDENT_WARNING_COUNT=5
LOG_INCIDENT_CRITICAL_COUNT=15
LOG_INCIDENT_WINDOW_SECONDS=300
# Errors must keep coming this long before an incident opens (shorter bursts are reported only)
LOG_INCIDENT_SUSTAIN_SECONDS=60
# No errors of the incident's patterns for this long resolves it
LOG_INCIDENT_RESOLVE_QUIET_SECONDS=600
# A pattern that always errors must reach this many times its usual rate
LOG_INCIDENT_BASELINE_FACTOR=3
# A warning still firing after this long becomes critical
LOG_INCIDENT_CRITICAL_AFTER_SECONDS=900
# How often rules are evaluated, and how far behind now the window ends (late lines)
LOG_INCIDENT_EVAL_SECONDS=30
LOG_INCIDENT_LAG_SECONDS=20

# ------------------------------------------------------------------------------
# METRICS (metrics-collector, VictoriaMetrics)
# ------------------------------------------------------------------------------
# How long metrics are kept: days, up to 90d. Lowering it deletes older data.
# Rough disk use: 50,000 series every 15 s is about 0.3 GB/day.
METRICS_RETENTION=30d
MAX_CONCURRENT_SCRAPES=200
# Larger /metrics responses are refused
MAX_SCRAPE_BODY_MB=20
# How often metric sources are reloaded from the database (new, paused, edited)
TARGET_RELOAD_INTERVAL_SECONDS=30
# How often routes, databases, hosts and containers are looked for in the metrics
DISCOVERY_INTERVAL_SECONDS=300
# How often dependency suggestions are looked for (client metrics, logs, incident timing)
DEPENDENCY_SCAN_MINUTES=30

# ------------------------------------------------------------------------------
# SYSTEM HEALTH (Observability > System Health)
# ------------------------------------------------------------------------------
SYSTEM_HEALTH_PROBE_SECONDS=30
SYSTEM_HEALTH_TIMEOUT_SECONDS=5
# Answers slower than this show the component as degraded
SYSTEM_HEALTH_SLOW_MS=1000
# Components not deployed here, comma separated, e.g. vmalert,victorialogs,dependency-tracker
SYSTEM_HEALTH_SKIP=

# ------------------------------------------------------------------------------
# DATA RETENTION AND MAINTENANCE (maintenance-scheduler)
# ------------------------------------------------------------------------------
# Health-check history: standard, and shorter once the database passes
# DB_SIZE_WARN_MB / DB_SIZE_CRITICAL_MB
HEALTH_RETENTION_DAYS=90
HEALTH_RETENTION_MODERATE_DAYS=60
HEALTH_RETENTION_AGGRESSIVE_DAYS=30
DB_SIZE_WARN_MB=1000
DB_SIZE_CRITICAL_MB=2000
EVENT_TRAIL_RETENTION_DAYS=180
ALERT_HISTORY_RETENTION_DAYS=30
# Resolved incidents older than this are deleted
INCIDENT_RETENTION_DAYS=90
# Delivered alerts (the Alerts delivery log) older than this are deleted
NOTIFICATION_RETENTION_DAYS=60
# Resolved alarms (and their timelines) older than this are deleted
ALARM_RETENTION_DAYS=90
# Requests to Pulsimo's own API (Pulsimo → API metrics) older than this are deleted
API_METRICS_RETENTION_DAYS=30
# Schedules (cron, in TZ)
CLEANUP_CRON=0 2 * * *
AGGREGATION_CRON=5 * * * *
DEEP_CLEANUP_CRON=0 3 * * 0
TZ=UTC

# ------------------------------------------------------------------------------
# LOG LEVELS (trace, debug, info, warn, error)
# ------------------------------------------------------------------------------
API_LOG_LEVEL=info
CHECKER_LOG_LEVEL=info
NOTIFICATION_LOG_LEVEL=info
METRICS_LOG_LEVEL=info
DEPENDENCY_LOG_LEVEL=info

# ------------------------------------------------------------------------------
# INTERNAL ADDRESSES (only change if you rename services or run them elsewhere)
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8080
CHECKER_SERVICE_URL=http://checker:8081
NOTIFICATION_SERVICE_URL=http://notification:8082
DEPENDENCY_TRACKER_SERVICE_URL=http://dependency-tracker:8083
MAINTENANCE_SERVICE_URL=http://maintenance-scheduler:3007
METRICS_COLLECTOR_URL=http://metrics-collector:8084
METRICS_STORE_URL=http://victoriametrics:8428
LOGS_URL=http://victorialogs:9428
VMALERT_URL=http://vmalert:8880
FRONTEND_INTERNAL_URL=http://frontend:3000
CHECKER_HEALTH_PORT=8081
NOTIFICATION_HEALTH_PORT=8082
DEPENDENCY_TRACKER_PORT=8083
MAINTENANCE_PORT=3007
